      "parameters": {
        "jsCode": "// Get the AI response\nconst aiResponse = $input.first().json.output || '';\n\n// CLEANING: Remove Markdown if present (```json ... ```)\nlet cleanText = aiResponse.trim();\nif (cleanText.startsWith('```')) {\n  cleanText = cleanText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n}\n\n// CHECK: Is it JSON?\ntry {\n  // Try to parse it\n  const parsed = JSON.parse(cleanText);\n  \n  // If it parses AND has 'scenario_type', it's the Final JSON\n  if (parsed.scenario_type && parsed.parameters) {\n    return [\n      { \n        json: { \n          type: 'final_json', \n          data: parsed \n        } \n      }\n    ];\n  }\n} catch (e) {\n  // Parsing failed, so it must be a text question\n}\n\n// If we get here, it is just a text message (Question)\nreturn [\n  { \n    json: { \n      type: 'question',\n      message: aiResponse \n    } \n  }\n];"
