    {
      "parameters": {
        "jsCode": "// Generate unique scenario ID\nconst timestamp = Date.now();\n// Added a fallback for scenario_type just in case\nconst scenarioType = $input.first().json.scenario_type || 'GENERIC';\nconst type = scenarioType.toUpperCase().replace(/_/g, '-');\nconst random = Math.floor(Math.random() * 1000).toString().padStart(3, '0');\nconst scenarioId = `SCEN-${type}-${timestamp}-${random}`;\n\nconst data = $input.first().json;\n\n// --- FIX START ---\n// We removed the reference to $('Scenario Input Webhook')\n// Now we check if user_id was passed into this node, otherwise we use 'anonymous'\nconst userId = data.user_id || 'anonymous';\n// --- FIX END ---\n\nreturn [{\n  json: {\n    scenario_id: scenarioId,\n    scenario_type: data.scenario_type,\n    scenario_description: data.scenario_description || 'No description provided',\n    parameters: data.parameters,\n    status: 'pending',\n    created_at: new Date().toISOString(),\n    user_id: userId\n  }\n}];"
      },
