        "jsCode": "// Determine which agents to call based on scenario type\nconst scenarioType = $input.first().json.scenario_type;\n\nconst agentMapping = {\n  'revenue_shock': ['liquidity', 'debt'],\n  'fx_crisis': ['market', 'debt', 'liquidity'],\n  'debt_refinancing': ['debt'],\n  'liquidity_squeeze': ['liquidity'],\n  'recession': ['liquidity', 'debt', 'market'],\n  'growth_expansion': ['liquidity', 'debt', 'market'],\n  'cost_inflation': ['liquidity', 'debt', 'market'],\n  'operational_efficiency': ['liquidity', 'debt']\n};\n\n// Default to all 3 if unknown\nconst agents = agentMapping[scenarioType] || ['liquidity', 'debt', 'market'];\n\nconst data = $input.first().json;\n\nreturn [{\n  json: {\n    ...data,\n    agents_to_call: agents,\n    agents_completed: [],\n    agent_results: {}\n  }\n}];"
