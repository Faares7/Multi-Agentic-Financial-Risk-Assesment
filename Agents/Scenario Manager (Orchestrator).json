    {
      "parameters": {
        "jsCode": "// Merge all agent results\nconst items = $input.all();\nconst scenarioId = $('Generate Scenario ID').first().json.scenario_id;\nconst originalData = $('Set Agent Flags').first().json;\n\nconst merged = {\n  scenario_id: scenarioId,\n  scenario_type: originalData.scenario_type,\n  parameters: originalData.parameters,\n  liquidity_results: null,\n  debt_results: null,\n  market_results: null,\n  agents_completed: []\n};\n\n// Process each agent response\nfor (const item of items) {\n  const body = item.json.body || item.json;\n  \n  if (body.agent_type === 'liquidity') {\n    merged.liquidity_results = body.results;\n    merged.agents_completed.push('liquidity');\n  } else if (body.agent_type === 'debt') {\n    merged.debt_results = body.results;\n    merged.agents_completed.push('debt');\n  } else if (body.agent_type === 'market') {\n    merged.market_results = body.results;\n    merged.agents_completed.push('market');\n  }\n}\n\nreturn [{ json: merged }];"
      },
