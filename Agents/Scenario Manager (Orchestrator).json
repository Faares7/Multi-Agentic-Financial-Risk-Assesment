{
  "name": "Scenario Manager (Orchestrator)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\nlet parsed;\n\n// --- PATH 1: Input comes from the Router (Already Parsed) ---\nif (inputJson.data && typeof inputJson.data === 'object') {\n  parsed = inputJson.data;\n} \n// --- PATH 2: Input comes directly from AI Agent (Raw Text) ---\nelse {\n  // Get the raw text safely\n  const aiResponse = inputJson.output || inputJson.text || inputJson.response || '';\n  \n  if (!aiResponse) {\n    throw new Error(`No input data found. Available keys: ${Object.keys(inputJson).join(', ')}`);\n  }\n\n  // Clean Markdown\n  let cleanJson = aiResponse.toString().trim();\n  if (cleanJson.startsWith('```json')) {\n    cleanJson = cleanJson.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  } else if (cleanJson.startsWith('```')) {\n    cleanJson = cleanJson.replace(/```\\n?/g, '').trim();\n  }\n\n  // Parse Text to JSON\n  try {\n    parsed = JSON.parse(cleanJson);\n  } catch (e) {\n    throw new Error(`Failed to parse JSON string: ${e.message}`);\n  }\n}\n\n// --- VALIDATION & DEFAULTS (Runs for both paths) ---\n\n// Validate required fields\nif (!parsed.scenario_type) {\n  throw new Error('Missing scenario_type');\n}\nif (!parsed.parameters) {\n  throw new Error('Missing parameters');\n}\n\n// Ensure all required parameters exist with defaults\nconst defaultParams = {\n  projection_horizon: 12,\n  severity: 'medium',\n  speed: 'gradual',\n  revenue_growth_rate: 0,\n  revenue_volatility_multiplier: 1.0,\n  dso_change: 0,\n  dio_change: 0,\n  dpo_change: 0,\n  opex_change_rate: 0,\n  cogs_margin_change: 0,\n  new_debt_issuance: 0,\n  debt_repayment_acceleration: 0,\n  interest_rate_shock: 0,\n  credit_spread_change: 0,\n  egp_usd_devaluation: 0,\n  fx_volatility_multiplier: 1.0,\n  import_volume_change: 0,\n  inflation_shock: 0,\n  dividend_payout_rate: 0,\n  equity_injection: 0,\n  simulation_runs: 10000\n};\n\n// Merge with defaults\nparsed.parameters = { ...defaultParams, ...parsed.parameters };\n\nreturn [{ json: parsed }];"
      },
